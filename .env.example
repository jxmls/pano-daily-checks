# ─── Database ────────────────────────────────────────────────────────────────
# Required. A standard PostgreSQL connection string.
# Example (local): postgresql://postgres:password@localhost:5432/panohub
# Example (Railway / Supabase / Neon): paste the connection string from your dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/panohub"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# "local" | "sso" | "both"  (defaults to "local" if not set)
NEXT_PUBLIC_AUTH_MODE="local"

# Shared password for local login (change this!)
NEXT_PUBLIC_LOCAL_PASSWORD="HotFix991!"

# Microsoft SSO — only needed when AUTH_MODE includes "sso"
NEXT_PUBLIC_AAD_CLIENT_ID=""
NEXT_PUBLIC_AAD_TENANT_ID=""

# ─── Email ────────────────────────────────────────────────────────────────────
# Default recipients for the mailto: links generated on submit.
# Engineers can also override these in the Settings panel at runtime.
NEXT_PUBLIC_CHECKLIST_TO=""
NEXT_PUBLIC_CHECKLIST_CC=""
NEXT_PUBLIC_CHECKLIST_BCC=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION="2.0.0"
